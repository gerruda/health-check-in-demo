# ==== healthbot: пример конфигурации ====
# Скопируй: cp .env.example .env — и заполни. Файл .env в .gitignore:
# токены и ключи НЕ попадают в git (NFR-1). Токен бота задаётся ТОЛЬКО здесь:
# командами в чате он не меняется и не выводится.

# Telegram
BOT_TOKEN=123456:ABC-замени-на-токен-из-BotFather
TELEGRAM_CHAT_ID_ATHLETE=111111111
TELEGRAM_CHAT_ID_WIFE=222222222

# Прокси для Telegram API: нужен при работе из РФ (напрямую api.telegram.org недоступен).
# Формат: http://host:port, https://host:port или socks5://host:port.
# Если прокси не нужен — оставь пустым. Логин/пароль в URL (user:pass@host) в логи не попадает.
BOT_PROXY_URL=http://127.0.0.1:12334

# Пути. DATA_ROOT — корень health/ с данными проекта.
# Бот живёт в health/бот/health-check-in, поэтому по умолчанию корень на два уровня выше.
DATA_ROOT=../..
LOG_DIR=logs
SETTINGS_DIR=настройки          # бот-owned YAML: athlete.yaml / wife.yaml

# LLM. По умолчанию — локальный Ollama: данные не покидают машину (NFR-1).
# LLM_MODE=api включает внешний OpenAI-совместимый сервис: текст уходит третьей стороне (FR-6.5).
LLM_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Для LLM_MODE=api: любой OpenAI-совместимый сервис (OpenAI, DeepSeek, OpenRouter, Groq, локальный прокси)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Второй провайдер при сбое активного: ollama | api | пусто
LLM_FALLBACK=

# Vision (скриншоты): отдельно от чата; пусто = как чат-провайдер/модель.
# Для чата локально, а vision через API — задай LLM_VISION_MODE=api и URL/KEY ниже.
LLM_VISION_MODE=ollama
LLM_VISION_MODEL=qwen2.5vl:3b
LLM_VISION_API_URL=
LLM_VISION_API_KEY=

# Векторный поиск по базе знаний (M3): Ollama /api/embed + кэш
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text:latest
# EMBEDDING_URL=http://127.0.0.1:11434

# Автоматический воскресный разбор: персонально /set weekly_review on|off
# и /set weekly_review_time 09:00; env — fallback/мастер.
SUNDAY_REVIEW_ENABLED=true
SUNDAY_REVIEW_TIME=09:00
SUNDAY_REVIEW_TZ=Europe/Moscow

# ==== Webhook (опционально; по умолчанию long polling) ====
# Для локальной отладки и обычного запуска оставь WEBHOOK_ENABLED=false.
# Webhook нужен для VPS за reverse proxy с TLS (Caddy/nginx): Telegram требует https.
WEBHOOK_ENABLED=false
# Публичный URL, который слушает Caddy/nginx (путь попадёт в локальный сервер):
WEBHOOK_URL=https://bot.example.com/telegram/webhook
# Локальный HTTP-сервер бота; наружу не открывать:
WEBHOOK_LISTEN=127.0.0.1:8080
# Секрет из Telegram (A-Za-z0-9_-); проверяется по заголовку X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=
# 1–100; 1 сохраняет порядок обновлений:
WEBHOOK_MAX_CONNECTIONS=1
# true — выбросить накопившиеся апдейты при смене webhook
WEBHOOK_DROP_PENDING=false

# ВАЖНО для VPS 1 ГБ: локальный Ollama с nomic-embed-text не поднимать.
# Оставь EMBEDDING_ENABLED=false (лексический поиск) или укажи удалённый Ollama:
# EMBEDDING_ENABLED=true
# EMBEDDING_URL=http://10.8.0.1:11434

# ==== Webhook по IP с self-signed сертификатом (без домена) ====
# Сгенерировать: healthbot -gen-webhook-cert -webhook-cert-out /etc/healthbot/webhook-cert.pem \
#   -webhook-key-out /etc/healthbot/webhook-key.pem -webhook-host 203.0.113.10
# WEBHOOK_URL=https://203.0.113.10:8443/telegram/webhook
# WEBHOOK_LISTEN=0.0.0.0:8443
# WEBHOOK_TLS_CERT=/etc/healthbot/webhook-cert.pem
# WEBHOOK_TLS_KEY=/etc/healthbot/webhook-key.pem

# ==== Prometheus-метрики (по умолчанию выключены) ====
# Включай на VPS, если Prometheus/Grafana будут scrape-ить localhost.
METRICS_ENABLED=false
METRICS_LISTEN=127.0.0.1:9090
METRICS_PATH=/metrics
